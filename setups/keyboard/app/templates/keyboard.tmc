// ACE COMBAT 8: WINGS OF THEVE - TCA Airbus keyboard profile
// Open this file in TARGET Script Editor, then Compile and Run.
// Generic example profile. Select your layout and game bindings with Configure_Keyboard.cmd.
// Main stick = aircraft; POV hat = camera; B11-B14 = wingman orders.
// Digital steering: this profile does not provide analog/XInput emulation.
// Official TARGET headers are supplied by your TARGET installation.
include "target.tmh"
include "throttle.tmh"

// Set to 1 if forward throttle brakes instead of accelerating.
define REVERSE_THROTTLE 0
// Set to 1 if pulling the stick back pitches down after binding the keys.
define REVERSE_PITCH 0
// No keyboard layout or user configuration is supplied by this template.
define KEYBOARD_CONFIGURED 0

define FLIGHT_ROLL_LEFT 0
define FLIGHT_ROLL_RIGHT 0
define FLIGHT_PITCH_DOWN 0
define FLIGHT_PITCH_UP 0
define FLIGHT_YAW_LEFT 0
define FLIGHT_YAW_RIGHT 0
define CAMERA_UP 0
define CAMERA_DOWN 0
define CAMERA_LEFT 0
define CAMERA_RIGHT 0

define ACTION_ACCEL 0
define ACTION_BRAKE 0
define ACTION_GUN 0
define ACTION_MISSILE 0
define ACTION_WEAPON 0
define ACTION_TARGET 0
define ACTION_FLARES 0
define ACTION_VIEW 0
define ACTION_RADAR 0
define ACTION_CONFIRM 0
define ACTION_PAUSE 0
define ACTION_WING_UP 0
define ACTION_WING_DOWN 0
define ACTION_WING_LEFT 0
define ACTION_WING_RIGHT 0
define ACTION_AUTOPILOT 0
define ACTION_FOCUS 0

int throttleZone, highG, accelHeld, brakeHeld;

int ThrottleZone(int value)
{
    if(REVERSE_THROTTLE) value = -value;
    if(value < -4587) return -1;
    if(value > 4587) return 1;
    return 0;
}

// Shared throttle state prevents releasing high-G from cancelling an
// acceleration/braking command still requested by the physical lever.
int ThrottleKeys(int zone, int highGPressed)
{
    if(highGPressed) return 3;
    if(zone < 0) return 1;
    if(zone > 0) return 2;
    return 0;
}

int UpdateThrottle(int source, int value)
{
    int selected = SelectThrottle(source, value);
    if(selected & throttleMoved)
    {
        throttleZone = ThrottleZone(value);
        return 1;
    }
    return 0;
}

int ApplyThrottle()
{
    int keys = ThrottleKeys(throttleZone, highG);
    int accel = keys & 1;
    int brake = (keys >> 1) & 1;
    if(accel != accelHeld) { ActKey(ACTION_ACCEL | (KEYON * accel)); accelHeld = accel; }
    if(brake != brakeHeld) { ActKey(ACTION_BRAKE | (KEYON * brake)); brakeHeld = brake; }
}

int main()
{
    // Refuse to capture hardware or send keys before an explicit user choice.
    if(!KEYBOARD_CONFIGURED)
    {
        printf("Run Configure_Keyboard.cmd, choose your layout, then use the generated .local script.%c", 10);
        return 1;
    }
    // Other common TARGET controllers stay outside this profile.
    Configure(&Joystick, MODE_EXCLUDED);
    Configure(&JoystickF18, MODE_EXCLUDED);
    Configure(&Throttle, MODE_EXCLUDED);
    Configure(&HCougar, MODE_EXCLUDED);
    Configure(&T16000, MODE_EXCLUDED);
    Configure(&T16000L, MODE_EXCLUDED);
    Configure(&TWCSThrottle, MODE_EXCLUDED);
    Configure(&LMFD, MODE_EXCLUDED);
    Configure(&RMFD, MODE_EXCLUDED);
    Configure(&A320Copilot, MODE_EXCLUDED);
    Configure(&TCAQuadrant34, MODE_EXCLUDED);
    Configure(&TFRPRudder, MODE_EXCLUDED);
    Configure(&TFRPHARudder, MODE_EXCLUDED);

    // Keyboard only: no Combined joystick axes to cause duplicate steering.
    if(Init(&EventHandle, CREATE_KEYBOARD)) return 1;
    if((&A320Pilot == &joy0) | (&TCAQuadrant12 == &joy0))
    {
        printf("Connect T.A320 Pilot and TCA Q-Eng 1&2, then run again.%c", 10);
        return 1;
    }
    SetKBRate(50, 50);
    // Numeric HID outputs were generated for the explicitly selected Windows layout.
    // No TARGET ASCII layout table or fallback is used.
    // Remove default DirectX buttons, detents, and all unused axes.
    int i;
    while(i<64)
    {
        MapKey(&A320Pilot, i, 0);
        MapKey(&TCAQuadrant12, i, 0);
        i = i+1;
    }
    i = IN_POSITION_AXES;
    while(i<IN_POSITION_HAT)
    {
        MapAxis(&A320Pilot, i, 0);
        MapAxis(&TCAQuadrant12, i, 0);
        i = i+1;
    }

    InitThrottle(A320Pilot[THR], TCAQuadrant12[QT_LEFT]);
    // Small center zones; beyond the zone, each direction holds a key.
    KeyAxis(&A320Pilot, JOYX, 0, AXMAP2(LIST(0,46,54,100), FLIGHT_ROLL_LEFT,0,FLIGHT_ROLL_RIGHT));
    if(REVERSE_PITCH)
        KeyAxis(&A320Pilot, JOYY, 0, AXMAP2(LIST(0,46,54,100), FLIGHT_PITCH_UP,0,FLIGHT_PITCH_DOWN));
    else
        KeyAxis(&A320Pilot, JOYY, 0, AXMAP2(LIST(0,46,54,100), FLIGHT_PITCH_DOWN,0,FLIGHT_PITCH_UP));
    KeyAxis(&A320Pilot, RUDDER, 0, AXMAP2(LIST(0,41,59,100), FLIGHT_YAW_LEFT,0,FLIGHT_YAW_RIGHT));

    MapKey(&A320Pilot, TS1, ACTION_GUN);         // Hold: machine gun (example binding)
    MapKey(&A320Pilot, TS2, PULSE+ACTION_MISSILE);   // Missile / selected special weapon
    MapKey(&A320Pilot, TS3, PULSE+ACTION_WEAPON);   // Switch weapon
    MapKey(&A320Pilot, TS4, PULSE+ACTION_TARGET);   // Change target
    // B5 is handled below for acceleration + braking (high-G).
    MapKey(&A320Pilot, B6, PULSE+ACTION_FLARES);    // Countermeasures
    MapKey(&A320Pilot, B7, PULSE+ACTION_VIEW);    // Change view
    MapKey(&A320Pilot, B8, PULSE+ACTION_RADAR);    // Radar/map size
    MapKey(&A320Pilot, B9, PULSE+ACTION_CONFIRM);    // Menu confirm
    MapKey(&A320Pilot, B10, PULSE+ACTION_PAUSE);   // Pause / menu back
    MapKey(&A320Pilot, B11, PULSE+ACTION_WING_UP); // Wingman order up
    MapKey(&A320Pilot, B12, PULSE+ACTION_WING_DOWN); // Wingman order down
    MapKey(&A320Pilot, B13, PULSE+ACTION_WING_LEFT); // Wingman order left
    MapKey(&A320Pilot, B14, PULSE+ACTION_WING_RIGHT); // Wingman order right
    MapKey(&A320Pilot, B15, ACTION_AUTOPILOT);         // Hold: autopilot / level aircraft
    MapKey(&A320Pilot, B16, ACTION_FOCUS);         // Hold: camera-control/target-focus action
    // Camera directions must be held; release recenters according to the game.
    MapKey(&A320Pilot, H1U, CAMERA_UP);
    MapKey(&A320Pilot, H1D, CAMERA_DOWN);
    MapKey(&A320Pilot, H1L, CAMERA_LEFT);
    MapKey(&A320Pilot, H1R, CAMERA_RIGHT);
    MapKey(&TCAQuadrant12, QT_BTN1, PULSE+ACTION_MISSILE); // Left red pushbutton: missile
    MapKey(&TCAQuadrant12, QT_BTN2, PULSE+ACTION_FLARES); // Right red pushbutton: flares

    printf("AC8 TCA profile loaded: stick=aircraft, hat=camera, B11-B14=wingmen.%c", 10);
    printf("Move either throttle after Run; the last moved controls speed. Stop the profile after playing.%c", 10);
}

int EventHandle(int type, alias o, int x)
{
    int source;
    if(((&o == &TCAQuadrant12) & (x == QT_LEFT)) | ((&o == &A320Pilot) & (x == THR)))
    {
        source = (&o == &TCAQuadrant12);
        if(UpdateThrottle(source, o[x])) ApplyThrottle();
    }
    if((&o == &A320Pilot) & (x == B5))
    {
        highG = !!o[x];
        ApplyThrottle();
    }
    DefaultMapping(&o, x);
}

// Offline compiler/state check; does not call Init or send input.
int ValidateProfile()
{
    int forward = -1;
    if(REVERSE_THROTTLE) forward = 1;
    if(ValidateThrottle()) return 10;
    if(ThrottleZone(0)) return 11;
    if(ThrottleZone(-32767) != forward) return 12;
    if(ThrottleZone(32767) != -forward) return 13;
    if(ThrottleKeys(-1,0) != 1) return 1;
    if(ThrottleKeys(0,0) != 0) return 2;
    if(ThrottleKeys(1,0) != 2) return 3;
    if(ThrottleKeys(-1,1) != 3) return 4;
    if(ThrottleKeys(0,1) != 3) return 5;
    if(ThrottleKeys(1,1) != 3) return 6;
    InitThrottle(0,0);
    throttleZone = 0;
    if(UpdateThrottle(0,655)) return 14;
    if(throttleZone) return 15;
    if(!UpdateThrottle(0,-32767)) return 16;
    if(throttleZone != forward) return 17;
    if(!UpdateThrottle(1,32767)) return 18;
    if(throttleZone != -forward) return 19;
    if(UpdateThrottle(0,-32760)) return 20;
    if(throttleZone != -forward) return 21;
    if(ThrottleKeys(throttleZone,1) != 3) return 22;
    if(ThrottleKeys(throttleZone,0) != ThrottleKeys(-forward,0)) return 23;
    if(!UpdateThrottle(0,0)) return 24;
    if(ThrottleKeys(throttleZone,0)) return 25;
    InitThrottle(0,0);
    return 0;
}
